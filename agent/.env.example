# --- Honmaru relay (existing worker, untouched) ---
RELAY_HTTP=https://tiktokforwork.torubj0904.workers.dev
RELAY_WS=wss://tiktokforwork.torubj0904.workers.dev/ws
ORG_ID=owner/repo
# The runner acts as THIS user's AI. Copy from web-react: DevTools → Application → localStorage → sessionToken / userId
AGENT_USER_ID=tanaka
AGENT_SESSION_TOKEN=

# --- Daytona ---
DAYTONA_API_KEY=
# Repo the dry-run clones. A token with push rights is needed for the approve → PR step.
TARGET_REPO=Torutesu/hotel-honmaru-demo
GITHUB_USER=
GITHUB_TOKEN=
# 1 = reuse a stored dry-run result for the same instruction (demo insurance)
DEMO_CACHE=0

# --- Neo4j Aura (Query API over HTTPS) ---
NEO4J_URI=https://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Nosana: the model behind every call the runner makes ---
# Deploy a vLLM / Ollama template on Nosana (Qwen2.5-Coder-7B-Instruct recommended)
# and paste the job's public URL + /v1. Preflight fails until this answers.
LLM_BASE_URL=https://<job-id>.node.k8s.prd.nos.ci/v1
LLM_API_KEY=none
LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
