# --- Relay (the deployed backend the feed clients talk to) ---
RELAY_HTTP=https://tiktokforwork.torubj0904.workers.dev
RELAY_WS=wss://tiktokforwork.torubj0904.workers.dev/ws
ORG_ID=owner/repo
# The runner acts as THIS user's AI. Copy from the web feed client: DevTools → Application → localStorage → sessionToken / userId
AGENT_USER_ID=tanaka
AGENT_SESSION_TOKEN=

# --- Daytona ---
DAYTONA_API_KEY=
# Repo the dry-run clones. A token with push rights is needed for the approve → PR step.
TARGET_REPO=your-org/booking-site
GITHUB_USER=
GITHUB_TOKEN=
# 1 = reuse a stored dry-run result for the same instruction (demo insurance)
DEMO_CACHE=0

# --- Neo4j Aura (Query API over HTTPS) ---
NEO4J_URI=https://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Model: any OpenAI-compatible /v1 endpoint (patch proposals, graph summaries) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
